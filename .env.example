# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://teakadaipolitics.com

# "true" shows a "sample content" notice on articles and videos (off by default).
NEXT_PUBLIC_SAMPLE_CONTENT=false

# Keep "false" on previews. Set "true" only on the live domain to let search
# engines index the site and to output article structured data.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Official social accounts. Defaults are set in src/config/site.ts; set these only to override.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

# Optional external form endpoint (e.g. Formspree) that accepts JSON POSTs.
# Empty means the contact form validates but says submission is not live.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Reserved for the Phase 2 Django REST Framework backend. Not used in Phase 1.
NEXT_PUBLIC_API_BASE_URL=
